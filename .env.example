# Copy to .env for local docker compose runs.
# Do NOT commit real credentials.

VALKEY_PASSWORD=changeMeViaEnvFile
VALKEY_MAXMEMORY=64mb
VALKEY_MAXMEMORY_POLICY=allkeys-lru

COREDNS_IMAGE_REPO=ghcr.io/dragoangel
COREDNS_IMAGE_NAME=coredns-redis-cache
COREDNS_IMAGE_TAG=latest

NODE_CACHE_IMAGE_REPO=ghcr.io/dragoangel
NODE_CACHE_IMAGE_NAME=k8s-dns-node-redis-cache
NODE_CACHE_IMAGE_TAG=latest

COREDNS_BIND_IP=127.0.0.2
COREDNS_BIND_PORT=5353
COREDNS_METRICS_PORT=9253

NODE_CACHE_REPLICAS=2
NODE_CACHE_BIND_IP=127.0.0.2
NODE_CACHE_BIND_PORTS=5354-5355
NODE_CACHE_METRICS_PORTS=9254-9255

VALKEY_IMAGE_REPO=valkey
VALKEY_IMAGE_NAME=valkey
VALKEY_IMAGE_TAG=9-alpine

VALKEY_MASTER_BIND_IP=127.0.0.1
VALKEY_MASTER_PORT=6379

VALKEY_REPLICAS=2
VALKEY_REPLICA_BIND_IP=127.0.0.1
VALKEY_REPLICA_PORTS=6380-6381

# Optional redis_cache TTL overrides
# REDIS_CACHE_SUCCESS_MAX=1h
# REDIS_CACHE_SUCCESS_MIN=1m
# REDIS_CACHE_DENIAL_MAX=30m
# REDIS_CACHE_DENIAL_MIN=15s

# Optional timeout overrides
# REDIS_CACHE_TIMEOUT_CONNECT=1s
# REDIS_CACHE_TIMEOUT_READ=1s
# REDIS_CACHE_TIMEOUT_WRITE=2s
